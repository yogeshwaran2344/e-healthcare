# ========================================================
# MSG91 SMS Gateway Configuration (Automated Background SMS)
# Official MSG91 Dashboard: https://msg91.com/
# ========================================================

# Your MSG91 Auth Key (from MSG91 Dashboard -> User Profile -> AuthKey)
MSG91_AUTH_KEY=your_msg91_auth_key_here

# 6-character Approved Sender ID (e.g. NEUROC, HLTHCR)
MSG91_SENDER_ID=NEUROC

# Approved Flow IDs (from MSG91 -> SMS -> Flow)
MSG91_FLOW_ID_DEFAULT=your_test_flow_id
MSG91_FLOW_ID_MEDICATION=your_medication_flow_id
MSG91_FLOW_ID_ALERT=your_caretaker_alert_flow_id
MSG91_DLT_TE_ID=

# ========================================================
# Meta WhatsApp Cloud API Configuration (Optional)
# ========================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_MEDICATION_REMINDER=medication_reminder
WHATSAPP_TEMPLATE_HEALTH_ALERT=caretaker_health_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Default Recipient Mobile Number for Testing (e.g. +918618912755)
DEFAULT_ALERT_RECIPIENT=+918618912755

# Optional Database URL (defaults to SQLite healthcare.db locally)
# DATABASE_URL=postgresql://user:pass@host/dbname
