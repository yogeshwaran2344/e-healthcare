# ========================================================
# Meta WhatsApp Cloud API Configuration (Graph API)
# Official Meta for Developers: https://developers.facebook.com/
# ========================================================

# Your Meta System User or User Access Token (from Meta App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here

# Your Meta Phone Number ID (Found in WhatsApp -> API Setup -> Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Meta WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_here

# Meta Graph API Version (e.g., v20.0, v21.0)
WHATSAPP_API_VERSION=v20.0

# Optional: Approved Message Template Names in Meta WhatsApp Manager
WHATSAPP_TEMPLATE_MEDICATION_REMINDER=medication_reminder
WHATSAPP_TEMPLATE_HEALTH_ALERT=caretaker_health_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Default Recipient Mobile Number for Testing (E.164 format, e.g. +919876543210)
DEFAULT_ALERT_RECIPIENT=+919876543210

# Optional Database URL (defaults to SQLite healthcare.db locally)
# DATABASE_URL=postgresql://user:pass@host/dbname
