# Direct WhatsApp & SMS Multi-Channel Gateway Configuration
# No third-party account or sandbox registration needed.
# All messages trigger with 1-tap direct dispatch to any recipient mobile number.

# Default recipient for test scripts (E.164 format, e.g. +91XXXXXXXXXX)
DEFAULT_ALERT_RECIPIENT=+919876543210

# Optional Database URL (defaults to SQLite healthcare.db locally)
# DATABASE_URL=postgresql://user:pass@host/dbname
