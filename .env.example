# ========================================================
# Fast2SMS Quick Gateway Configuration (Automated Cellular SMS)
# Route 'q' sends free-text SMS directly to 10-digit Indian numbers without DLT registration
# Signup & get free API key from: https://www.fast2sms.com/ (Dev API)
# ========================================================

# Your Fast2SMS Authorization Key (from Fast2SMS Dashboard -> Dev API)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Route: 'q' for Quick SMS route (plain text, no DLT registration required)
FAST2SMS_ROUTE=q

# Default Recipient Mobile Number for Testing (10 digits or with +91)
DEFAULT_ALERT_RECIPIENT=+918618912755

# Optional Database URL (defaults to SQLite healthcare.db locally)
# DATABASE_URL=postgresql://user:pass@host/dbname
